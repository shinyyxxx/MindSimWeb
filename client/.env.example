# Public site path (must match how the SPA is hosted).
VITE_BASE_PATH=/mindillustrate/frontend/

# Backend HTTP origin only — no trailing slash. The app calls `${VITE_API_URL}/api/...`.
# Example (KMITL): https://turing.se.kmitl.ac.th/mindillustrate
# Nginx should proxy /mindillustrate/api/ -> http://127.0.0.1:8004/api/
VITE_API_URL=

# WebSocket base (scheme + host + optional path). Client opens `${VITE_WS_URL}/ws/{userId}`.
# Example: wss://turing.se.kmitl.ac.th/mindillustrate
# Nginx should proxy /mindillustrate/ws/ -> http://127.0.0.1:8004/ws/ (with Upgrade headers).
VITE_WS_URL=

VITE_GOOGLE_TTS_KEY=
