# Public site path (must match how the SPA is hosted).
VITE_BASE_PATH=/mindillustrate/frontend/

# Backend HTTP origin only — no trailing slash. The app calls `${VITE_API_URL}/api/...`.
# Example (KMITL): https://turing.se.kmitl.ac.th/mindillustrate
# Nginx should proxy /mindillustrate/api/ -> http://127.0.0.1:8004/api/
VITE_API_URL=

# WebSocket base: same path prefix as the API mount (not the site root). Client uses `${VITE_WS_URL}/ws/{userId}`.
# Example: wss://turing.se.kmitl.ac.th/mindillustrate/api → wss://.../mindillustrate/api/ws/user_1
# Use ONE nginx location /mindillustrate/api/ → backend (Upgrade headers for WebSocket).
VITE_WS_URL=

VITE_GOOGLE_TTS_KEY=
